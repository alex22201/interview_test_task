DJANGO_SECRET_KEY=change-me-to-a-random-secret-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=redirect_service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Used by Django when running outside docker-compose (e.g. locally with `uv run`).
# Inside docker-compose, DATABASE_URL is overridden to point at the `db` service.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/redirect_service
